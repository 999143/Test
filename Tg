client = TelegramClient("telegram_poster", API_ID, API_HASH)


async def send_post(group):
    try:
        if group["image"]:
            await client.send_file(
                group["chat"],
                group["image"],
                caption=group["message"]
            )
        else:
            await client.send_message(
                group["chat"],
                group["message"]
            )

        print(f"✓ Posted to {group['name']}")

    except Exception as e:
        print(f"✗ Error posting to {group['name']}: {e}")


async def main():
    await client.start()

    print("Telegram poster started.")

    while True:

        for group in GROUPS:
            await send_post(group)

        print(f"Waiting {INTERVAL} seconds...")
        await asyncio.sleep(INTERVAL)


with client:
    client.loop.run_until_complete(main())
